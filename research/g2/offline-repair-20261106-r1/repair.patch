+            dict(
+                scope="fixed recorded chunks only; alternative prefixes change future observations and require closed-loop validation",
+                cases=prefix_counts,
+            ),
+            indent=2,
+        )
+        + "\n"
+    )
+    return metrics
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser(description=__doc__)
